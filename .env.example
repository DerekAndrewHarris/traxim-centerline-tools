# Environment Configuration Template
# Copy this file to .env and customize for your environment

# Server Configuration
NODE_ENV=development
PORT=3001

# Temporary File Storage
TEMP_FILES_DIR=./temp-sessions
SESSION_EXPIRY_HOURS=24

# External API Endpoints
# OVERPASS_API_URL: optional self-hosted rail-only Overpass instance. When set, it's
# raced against the public mirrors (backend/services/osm/overpass.js) and — being
# local — will normally win, acting as the de facto primary. Leave unset to use only
# the public mirrors. Example for a local self-hosted instance:
# OVERPASS_API_URL=http://127.0.0.1:12345/api/interpreter
ELEVATION_API_URL=https://api.open-elevation.com/api/v1/lookup
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# API Rate Limiting (to avoid overwhelming external services)
OVERPASS_MAX_QUERIES_PER_HOUR=10
OVERPASS_RETRY_DELAY_MS=5000
ELEVATION_MAX_POINTS_PER_REQUEST=100

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,https://tools.traximrail.com

# Job Queue Configuration
MAX_CONCURRENT_JOBS=3
JOB_CLEANUP_INTERVAL_HOURS=1

# Logging
LOG_LEVEL=info
